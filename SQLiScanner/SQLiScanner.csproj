    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.6" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.5.0" />
    <PackageReference Include="Spectre.Console" Version="0.55.2" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resources\Payloads\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataSchema\DataSchema.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\AnalyzingPayloads\boolean_blind.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\AnalyzingPayloads\error_based.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\AnalyzingPayloads\time_blind.xml">
